# Built extension artefacts. The Vite build mirrors dist/ to the repo
# root so `chrome://extensions → Load unpacked → repo root` works
# without an extra cd. They regenerate on every `npm run build`, so
# tracking them only created noise in the git history.
/content.js
/content-blueprint.js
/interceptor.js
/service-worker.js
/assets/
/chunks/
/codesearch/
/diff/
/editor/
/graphview/
/objectview/
/sidepanel/
/studio/

# Internal docs, research, and agent workspaces stay local. The public repository
# contains the user-facing README plus source, tests, and release infrastructure.
/docs/
/bench/
/experiments/
/AGENTS.md
/CLAUDE.md
/plans/
/.claude/
