{
  "name": "crev-inspector",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "rm -rf dist content.js content-blueprint.js interceptor.js service-worker.js assets/ chunks/ codesearch/ diff/ editor/ objectview/ sidepanel/ studio/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:extension-load": "node scripts/browser.mjs --check",
    "browser:open": "node scripts/browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.37",
    "eslint": "^10.6.0",
    "happy-dom": "^20.8.9",
    "playwright": "1.58.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.2",
    "@codemirror/lint": "^6.9.4",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@lezer/highlight": "^1.2.3",
    "@types/js-beautify": "^1.14.3",
    "js-beautify": "^1.15.4"
  }
}
